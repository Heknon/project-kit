# Copy to .env.local. On Vercel, project-kit sets these; see the contract for what each environment gets.

# production, dev or preview. Unset locally.
APP_ENV=
# The deployment's public origin, no trailing slash. Unset in previews.
APP_URL=

# Bucket for files. Leave unset to turn storage off.
S3_BUCKET=
# The bucket's region.
S3_REGION=
# Prepended to every object key: unset in production, dev/ in dev, preview/pr-<n>/ in previews.
S3_PREFIX=
# IAM role assumed with the Vercel OIDC token. Vercel only: leave it unset locally.
S3_ROLE_ARN=
# S3-compatible endpoint for local development, with its static keys.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
