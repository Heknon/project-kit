# Copy to .env.local. Values for docker compose are in the README.
# On Vercel, project-kit sets these; see the contract for what each environment gets.

# production, dev or preview. Unset locally.
APP_ENV=
# The deployment's public origin, no trailing slash. Unset in previews.
APP_URL=

# Connection the app uses (pooled when the database has a pooler).
DATABASE_URL=
# Direct connection, used by migrations.
DATABASE_URL_UNPOOLED=

# Bucket for uploads. Leave unset to turn uploads off.
S3_BUCKET=
# The bucket's region.
S3_REGION=
# Prepended to every object key: unset in production, dev/ in dev, preview/pr-<n>/ in previews.
S3_PREFIX=
# IAM role assumed with the Vercel OIDC token. Vercel only.
S3_ROLE_ARN=
# S3-compatible endpoint for local development.
S3_ENDPOINT=
# Static keys for the local endpoint.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Signs session cookies. Generate one with: bunx auth secret
AUTH_SECRET=
# Google OAuth client. Leave unset to turn sign-in off.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The deployment's origin. Unset locally and in previews.
AUTH_URL=
# Sign-in proxy for previews: https://<dev domain>/api/auth. Unset locally.
AUTH_REDIRECT_PROXY_URL=
